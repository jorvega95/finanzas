ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finanzas
SUPABASE_URL=https://<project>.supabase.co
# Solo para proyectos Supabase LEGACY (HS256). Los proyectos nuevos usan
# JWT Signing Keys asimetricas y NO necesitan secreto: deja esto vacio y el
# backend verificara contra el JWKS publico del proyecto (SUPABASE_URL).
SUPABASE_JWT_SECRET=
SCHEDULER_ENABLED=false
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
BANXICO_TOKEN=
