ENV=dev
DATABASE_URL=postgresql+asyncpg://finanzas@/finanzas?host=/run/postgresql
# GLO-07: modo local mono-usuario (sin login). LOCAL_USER_ID = UUID del perfil
# dueño de los datos (el de ~/.config/finanzas/finanzas.env).
AUTH_MODE=local
LOCAL_USER_ID=
LOCAL_USER_EMAIL=
# Solo con AUTH_MODE=jwt (tests / futuro cliente remoto).
JWT_SECRET=
# Ruta a frontend/dist para servir la SPA desde FastAPI (vacío en desarrollo).
FRONTEND_DIST=
SCHEDULER_ENABLED=false
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
BANXICO_TOKEN=
